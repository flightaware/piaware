# -*- tcl -*-
#
# Tests for handle_update_request (update.tcl): FlightAware's servers can ask
# piaware to upgrade packages, restart services or reboot. Nothing may happen
# unless the local config allows it.
#
# Nothing here runs apt-get, restarts a service or reboots: every command that
# would is replaced by a stand-in that records what it was asked to do.

package require tcltest 2.2
package require Itcl

set testDir [file dirname [file normalize [info script]]]
set packageDir [file normalize [file join $testDir .. .. package]]

# update.tcl needs these for code replaced below; let the tests load on
# systems that don't have them.
foreach pkg {Tclx tls} {
	if {[catch {package require $pkg}]} {
		package provide $pkg 0
	}
}
foreach f {tryfinallyshim fa_sudo fa_sysinfo fa_services fa_piaware_config} {
	source [file join $packageDir $f.tcl]
}
source [file join $testDir update.tcl]

::tcltest::configure {*}$argv

namespace eval ::update::tests {
	namespace import ::tcltest::*

	variable events {}
	proc record {args} {
		variable events
		lappend events $args
	}

	# what the stand-ins report back
	variable aptFails {}
	variable aptError ""
	variable installed {}
	variable pidfileOk 1

	# --- stand-ins for everything that touches the system ---

	variable logs {}
	proc ::logger {msg} {
		lappend ::update::tests::logs $msg
	}
	proc ::reread_piaware_config {} {
		piawareConfig read_config
	}
	proc ::create_named_pidfile {path} {
		if {!$::update::tests::pidfileOk} {
			error "already locked"
		}
		::update::tests::record pidfile-create $path
	}
	proc ::cleanup_named_pidfile {path} {
		::update::tests::record pidfile-cleanup $path
	}
	proc ::run_command_as_root_log_output {script args} {
		::update::tests::record apt {*}$args
		if {$::update::tests::aptError ne ""} {
			error $::update::tests::aptError
		}
		# the apt-get helper's subcommands listed in aptFails report failure
		return [expr {[lindex $args 0] ni $::update::tests::aptFails}]
	}
	proc ::query_dpkg_names_and_versions {pattern} {
		if {$pattern in $::update::tests::installed} {
			return [list $pattern 1.0]
		}
		return ""
	}
	proc ::fa_services::attempt_service_restart {service action} {
		::update::tests::record service $action $service
	}
	proc ::fa_sudo::exec_as {args} {
		::update::tests::record exec_as {*}$args
	}
	proc ::restart_piaware {} {
		::update::tests::record restart-piaware
	}
	set ::adsbDataService dump1090-fa

	# A real config object with piaware's real option definitions and
	# defaults, read from a real file holding $contents. It reads only that
	# file: piaware's own combined config would also read the system's
	# /usr/share/piaware-support/piaware-image-config.txt, which on a PiAware
	# image could change the defaults under test.
	proc config {contents} {
		catch {itcl::delete object ::piawareConfig}
		variable configPath [::tcltest::makeFile $contents piaware-update-test.conf]
		set path $configPath
		set metadata [::fa_piaware_config::piaware_standard_settings #auto]
		::fa_piaware_config::new ::fa_piaware_config::ConfigGroup ::piawareConfig -metadata $metadata
		::piawareConfig add [::fa_piaware_config::new ::fa_piaware_config::ConfigFile #auto \
			-filename $path -metadata $metadata -priority 100]
	}

	proc reset {} {
		variable events {}
		variable logs {}
		variable aptFails {}
		variable aptError ""
		variable installed {}
		variable pidfileOk 1
	}

	# Run an update request and return what it did. An error is returned as
	# {error message} after the events, so a test can assert both.
	proc request {type action {setup {}}} {
		reset
		uplevel 1 $setup
		set row(action) $action
		if {[catch {handle_update_request $type row} result]} {
			record error $result
		}
		variable events
		return $events
	}

	# The "update denied" log lines, with the test config file's path
	# replaced by FILE
	proc denial_log {} {
		variable logs
		variable configPath
		set out {}
		foreach l [lsearch -all -inline $logs "update denied*"] {
			lappend out [string map [list $configPath FILE] $l]
		}
		return $out
	}

	# --- permission: the config decides, and the default is no ---

	# A denied request does nothing, raises no error (an error makes the
	# client disconnect from FlightAware), and logs where the setting came from.
	test auto-denied-by-default "an auto update does nothing when the config doesn't allow it (the default)" -body {
		config ""
		list [request auto full] [denial_log]
	} -result {{} {{update denied by local configuration (defaults)}}}

	test manual-denied-when-only-auto-allowed "a manual update needs allow-manual-updates, not allow-auto-updates" -body {
		config "allow-auto-updates yes\nallow-manual-updates no\n"
		list [request manual "full reboot"] [denial_log]
	} -result {{} {{update denied by local configuration (FILE:2)}}}

	test unknown-request-type-ignored "an update request of an unknown type does nothing, even with both allowed" -body {
		config "allow-auto-updates yes\nallow-manual-updates yes\n"
		request forced "full reboot"
	} -result {}

	# --- what an allowed request does ---

	test dump1090-upgrade "an allowed dump1090 update upgrades and restarts it, but doesn't restart it if the upgrade failed" -body {
		config "allow-auto-updates yes\n"
		list [request auto dump1090] [request auto dump1090 {variable aptFails upgrade-package}]
	} -result {{{pidfile-create /run/piaware/upgrader.pid} {apt update} {apt upgrade-package dump1090-fa} {service restart dump1090} {pidfile-cleanup /run/piaware/upgrader.pid}} {{pidfile-create /run/piaware/upgrader.pid} {apt update} {apt upgrade-package dump1090-fa} {pidfile-cleanup /run/piaware/upgrader.pid}}}

	test piaware-release-preferred "a piaware update upgrades piaware-release when installed, then restarts piaware" -body {
		config "allow-manual-updates yes\n"
		request manual piaware {variable installed {piaware-release piaware-gui-release}}
	} -result {{pidfile-create /run/piaware/upgrader.pid} {apt update} {apt upgrade-package piaware-release} {apt upgrade-package piaware-gui-release} {pidfile-cleanup /run/piaware/upgrader.pid} restart-piaware}

	# (Only "apt update" may run: how many times isn't the point here.)
	test package-list-failure-stops-upgrades "if refreshing package lists fails, nothing is upgraded or restarted" -body {
		config "allow-auto-updates yes\n"
		set events [request auto "packages dump1090 restart_piaware" {variable aptFails update}]
		list [lsearch -all -inline -not -exact $events {apt update}] [expr {{apt update} in $events}]
	} -result {{{pidfile-create /run/piaware/upgrader.pid} {pidfile-cleanup /run/piaware/upgrader.pid}} 1}

	test reboot-ends-the-request "nothing after a reboot or a halt in the action list runs" -body {
		config "allow-auto-updates yes\n"
		list [request auto "restart_dump1090 reboot restart_piaware halt"] [request auto "restart_receiver halt reboot"]
	} -result {{{pidfile-create /run/piaware/upgrader.pid} {service restart dump1090} {exec_as -root -- /sbin/reboot &} {pidfile-cleanup /run/piaware/upgrader.pid}} {{pidfile-create /run/piaware/upgrader.pid} {service restart dump1090-fa} {exec_as -root -- /sbin/halt &} {pidfile-cleanup /run/piaware/upgrader.pid}}}

	test lock-held-does-nothing "if another upgrader holds the lock, the request does nothing" -body {
		config "allow-auto-updates yes\n"
		request auto "dump1090 reboot" {variable pidfileOk 0}
	} -result {}

	test lock-released-on-error "the upgrader lock is released even if an action raises an error" -body {
		config "allow-auto-updates yes\n"
		request auto dump1090 {variable aptError "apt helper missing"}
	} -result {{pidfile-create /run/piaware/upgrader.pid} {apt update} {pidfile-cleanup /run/piaware/upgrader.pid} {error {apt helper missing}}}

	catch {itcl::delete object ::piawareConfig}

	# cleanupTests resets the counters, so read the failure count first and
	# exit non-zero on failure.
	set failed $::tcltest::numTests(Failed)
	cleanupTests
	exit [expr {$failed > 0}]
}
